# ---- Database (Postgres). Use a Neon/Supabase pooled connection string in prod ----
DATABASE_URL=postgresql://modaya:modaya@127.0.0.1:55432/modaya

# ---- Sessions ----
# No session secret is needed: tokens are random 256-bit values and only their
# SHA-256 hash is stored, so there is nothing to sign.

# Public origin of the app (used in magic-link style URLs and absolute redirects)
APP_URL=http://localhost:3000

# ---- Object storage (S3-compatible: Cloudflare R2 in production) ----
S3_ENDPOINT=http://127.0.0.1:4569
S3_REGION=auto
S3_BUCKET=modaya-media
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_FORCE_PATH_STYLE=true
# Optional: pin the browser-facing endpoint. Leave blank to derive it from the
# request Host header (needed when running behind a port-proxy preview).
S3_PUBLIC_ENDPOINT=
# Port used for the browser-facing object storage endpoint when deriving it.
S3_PORT=4569

# ---- Optional multimodal model layer (Phases 2-3). Absent key => that layer is
# reported as unavailable in the UI instead of guessed at. ----
# MODAYA_VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODAYA_VISION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ---- Worker ----
WORKER_POLL_MS=1500
